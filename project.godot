; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Shipping Lanes"
config/name.macos="Container Ship Sim"
run/main_scene="res://features/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps.macos=60

[layer_names]

3d_physics/layer_1="Hulls"
3d_physics/layer_2="Shore and piers"
3d_physics/layer_3="Triggers"
3d_physics/layer_4="Cargo visuals (reserved)"
3d_physics/layer_5="Characters (reserved)"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.macos="forward_plus"
rendering_device/driver.macos="metal"
rendering_device/fallback_to_opengl3=true
scaling_3d/mode.macos=1
scaling_3d/fsr_sharpness.macos=0.3
environment/defaults/default_clear_color=Color(0.025, 0.065, 0.1, 1)
textures/vram_compression/import_etc2_astc=true
