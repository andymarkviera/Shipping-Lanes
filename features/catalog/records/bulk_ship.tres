"hold_forward": {"capacity_grams": 400000000, "cargo_type_ids": ["cargo_bulk_grain", "cargo_bulk_coal", "cargo_bulk_ore", "cargo_bulk_limestone", "cargo_bulk_salt"]},
"hold_aft": {"capacity_grams": 600000000, "cargo_type_ids": ["cargo_bulk_grain", "cargo_bulk_coal", "cargo_bulk_ore", "cargo_bulk_limestone", "cargo_bulk_salt"]}
}
