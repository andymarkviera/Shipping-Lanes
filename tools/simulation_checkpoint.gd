extends RefCounted
## Fixed-tick input playback of the production motion model in unobstructed water.
## Position is integrated here; collisions stay covered by CollisionCheck.
const DT: float = 1.0 / 60.0
const FIXTURES: Dictionary = {
	"accelerate": [{"ticks": 444, "throttle_axis": 1.0}],
	"brake": [{"ticks": 444, "throttle_axis": 1.0}, {"ticks": 720, "throttle_axis": -1.0}],
	"turn": [{"ticks": 444, "throttle_axis": 1.0}, {"ticks": 600, "rudder": 1.0}],
	"sideways": [{"ticks": 300, "thruster": 1.0}, {"ticks": 120}],
	"neutral": [{"ticks": 444, "throttle_axis": 1.0}, {"ticks": 300, "neutral": true}],
}
## Captured from accepted tuning on 2026-10-19, never regenerated by checks.
## Each metric is [reference, absolute tolerance], in the named SI units.
const BASELINES: Dictionary = {
	"accelerate": {"speed_mps": [4.00465, 0.03], "distance_m": [14.05862, 0.15],
		"reach_4mps_seconds": [7.4, 0.10], "ahead_power_seconds": [6.40833, 0.03]},
	"brake": {"speed_mps": [-0.12640, 0.03], "z_m": [40.36009, 0.25],
		"stop_seconds": [18.98333, 0.10], "braking_distance_m": [26.32986, 0.25],
		"astern_power_seconds": [5.635, 0.03]},
	"turn": {"heading_degrees": [27.77449, 0.2], "x_m": [-14.33049, 0.2],
		"z_m": [70.40244, 0.3], "speed_mps": [7.30627, 0.05]},
	"sideways": {"x_m": [-4.03194, 0.08], "side_mps": [-0.38852, 0.02],
		"heading_degrees": [0.0, 0.02]},
	"neutral": {"speed_mps": [2.95517, 0.03], "distance_m": [32.08505, 0.2],
		"engine": [0.0, 0.0001], "ahead_power_seconds": [6.9, 0.03]},
}

static func deviations(fixture: String, result: Dictionary) -> Array[String]:
	var errors: Array[String] = []
	for metric: String in BASELINES[fixture]:
		var reference: Array = BASELINES[fixture][metric]
		var actual: float = result.get(metric, NAN)
		if not is_finite(actual) or absf(actual - reference[0]) > reference[1]:
			errors.append("%s.%s: expected %.5f +/- %.5f, observed %.5f" % [fixture, metric, reference[0], reference[1], actual])
	return errors

static func replay(parent: Node, segments: Array, acceleration_scale: float = 1.0) -> Dictionary:
	var ship: HandlingShip = HandlingShip.new()
	parent.add_child(ship)
	ship.set_physics_process(false)
	# Historical model baseline excludes the separately tested neutral comfort assist.
	ship.definition.neutral_stop_speed_mps = 0.0
	ship.definition.forward_acceleration_mps2 *= acceleration_scale
	var ticks: int = 0
	var ahead_power_seconds: float = 0.0
	var astern_power_seconds: float = 0.0
	var distance: float = 0.0
	var reach_4mps_seconds: float = -1.0
	var stop_seconds: float = -1.0
	var braking_distance_m: float = -1.0
	var telemetry: Array[Dictionary] = []
	var endpoints: Array[Dictionary] = []
	for segment: Dictionary in segments:
		var segment_start_distance: float = distance
		for index: int in range(segment.ticks):
			if segment.get("neutral", false): ship.zero_throttle()
			else: ship.command_throttle(ship.commanded_throttle + segment.get("throttle_axis", 0.0) * ship.definition.command_rate_per_second * DT)
			ship.maneuver(segment.get("rudder", 0.0), segment.get("thruster", 0.0))
			var previous_speed: float = ship.forward_speed()
			ship.advance_motion(DT)
			ship.position += ship.velocity * DT
			distance += ship.velocity.length() * DT
			ahead_power_seconds += maxf(ship.actual_throttle, 0.0) * DT
			astern_power_seconds += maxf(-ship.actual_throttle, 0.0) * DT
			ticks += 1
			if reach_4mps_seconds < 0.0 and ship.forward_speed() >= 4.0:
				reach_4mps_seconds = ticks * DT
			if stop_seconds < 0.0 and previous_speed > 0.0 and ship.forward_speed() <= 0.0:
				stop_seconds = ticks * DT
				braking_distance_m = distance - segment_start_distance - ship.velocity.length() * DT
			if ticks % 60 == 0:
				telemetry.append({"tick": ticks, "seconds": ticks * DT,
					"command": ship.commanded_throttle, "engine": ship.actual_throttle,
					"speed_mps": ship.forward_speed(), "rudder": ship.rudder,
					"thruster": ship.lateral_order})
		endpoints.append({"tick": ticks, "speed_mps": ship.forward_speed(),
			"distance_m": distance, "heading_degrees": -rad_to_deg(ship.rotation.y)})
	var result: Dictionary = {"ticks": ticks, "seconds": ticks * DT,
		"speed_mps": ship.forward_speed(), "side_mps": ship.lateral_speed(),
		"x_m": ship.position.x, "z_m": ship.position.z, "distance_m": distance,
		"heading_degrees": -rad_to_deg(ship.rotation.y),
		"command": ship.commanded_throttle, "engine": ship.actual_throttle,
		"reach_4mps_seconds": reach_4mps_seconds, "stop_seconds": stop_seconds,
		"braking_distance_m": braking_distance_m,
		"ahead_power_seconds": ahead_power_seconds, "astern_power_seconds": astern_power_seconds,
		"telemetry": telemetry, "endpoints": endpoints}
	parent.remove_child(ship)
	ship.free()
	return result

static func run(parent: Node) -> Dictionary:
	var results: Dictionary = {}
	for fixture: String in FIXTURES:
		results[fixture] = replay(parent, FIXTURES[fixture])
		var summary: Dictionary = results[fixture].duplicate()
		summary.erase("telemetry")
		print("SIMULATION_CHECKPOINT ", fixture, " ", JSON.stringify(summary))
	return results
